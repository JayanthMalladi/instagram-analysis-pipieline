# Copy to .env and fill in. .env is git-ignored; never commit real tokens.
IG_ACCESS_TOKEN=
# Optional for Instagram Login tokens (IGAA...); required for Facebook Login tokens (EAA...).
IG_USER_ID=

# Your audience's timezone (IANA name) for the recommendations.
IG_TIMEZONE=Asia/Kolkata

# Optional: only needed for `exchange-token`. If set, requests are also
# signed with appsecret_proof.
IG_APP_ID=
IG_APP_SECRET=

# Optional: niche research (Claude's niche_research tool). Needs a Facebook Login
# token (EAA...), see README "Niche research". Keep IG_ACCESS_TOKEN as is for your
# own reels and put the Facebook Login token here.
# IG_NICHE_ACCESS_TOKEN=
# IG_NICHE_USER_ID=
# Default creators (public Business/Creator accounts) and hashtags to study.
# IG_NICHE_CREATORS=creator_one,creator_two
# IG_NICHE_HASHTAGS=fitnesstransformation,gymtok

# Optional overrides
# IG_API_VERSION=v23.0
# IG_GRAPH_HOST=graph.instagram.com   # normally picked from the token type
