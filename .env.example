# Copy to .env and fill in. .env is git-ignored; never commit real tokens.
IG_ACCESS_TOKEN=
# Optional for Instagram Login tokens (IGAA...); required for Facebook Login tokens (EAA...).
IG_USER_ID=

# Your audience's timezone (IANA name) for the recommendations.
IG_TIMEZONE=Asia/Kolkata

# Optional: only needed for `exchange-token`. If set, requests are also
# signed with appsecret_proof.
IG_APP_ID=
IG_APP_SECRET=

# Optional overrides
# IG_API_VERSION=v23.0
# IG_GRAPH_HOST=graph.instagram.com   # normally picked from the token type
